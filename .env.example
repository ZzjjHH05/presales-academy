# 站点公开 URL（生产值配置在 Vercel 控制台，不入库）
NEXT_PUBLIC_SITE_URL=
# Turso 托管数据库（生产值配置在 Vercel 控制台，不入库）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI 网关配置（真实密钥只写在 .env.local，绝不提交 git）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 限流盐（通用）：AI 限流与登录防爆破共用，生产必配随机串（openssl rand -hex 16）
AI_RATE_SALT=
